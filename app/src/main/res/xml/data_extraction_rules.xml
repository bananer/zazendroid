        <include>
            <sharedPreferences />
            <databases />
            <files path="datastore/" />
            <files path="catalog-cache/" />
        </include>
    </cloud-backup>
    <device-transfer>
        <include>
            <sharedPreferences />
            <databases />
            <files path="datastore/" />
            <files path="catalog-cache/" />
        </include>
    </device-transfer>
</data-extraction-rules>
