<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allows cleartext to the emulator host loopback so local
     validation servers (plain HTTP, e.g. test_data/server.py on :8042) work.
     Release builds have no networkSecurityConfig and keep the manifest
     android:usesCleartextTraffic="false" default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
